<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_centerHorizontal="true">

    <LinearLayout
        android:id="@+id/statusbar"
        android:background="?attr/statusBar"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:gravity="center_horizontal"
        android:layout_centerHorizontal="true" />

    <LinearLayout
        android:id="@+id/maincroparea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <com.yepgoryo.CaptureCap.SelectScreenCropAreaWidget
            android:id="@+id/croparea"
            android:layout_width="300dp"
            android:layout_height="300dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pixelwidth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pxwidth: 1"
                        android:textSize="16sp"
                        android:layout_centerHorizontal="true" />

                    <EditText
                        android:id="@+id/pixelwidthvalue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pixelheight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pxheight: 2"
                        android:textSize="16sp"
                        android:layout_marginLeft="16dp"
                        android:layout_centerHorizontal="true" />

                    <EditText
                        android:id="@+id/pixelheightvalue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pixelx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pxX: 1"
                        android:textSize="16sp"
                        android:layout_centerHorizontal="true" />

                    <EditText
                        android:id="@+id/pixelxvalue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/pixely"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="pxY: 1"
                        android:textSize="16sp"
                        android:layout_marginLeft="16dp"
                        android:layout_centerHorizontal="true" />

                    <EditText
                        android:id="@+id/pixelyvalue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="text" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
